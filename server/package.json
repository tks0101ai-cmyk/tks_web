{
  "name": "tokosi-dashboard-server",
  "version": "1.0.0",
  "private": true,
  "description": "Node/Express backend for TOKOSI Dashboard, Supabase and HR Google Sheets.",
  "main": "index.js",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "build": "node -e \"console.log('Express app: no build step required')\"",
    "start": "node --max-old-space-size=1024 index.js",
    "dev": "node --max-old-space-size=4096 index.js",
    "worker": "node --max-old-space-size=1024 worker.js",
    "test": "node --max-old-space-size=4096 --test",
    "db:migrate": "node db/migrate.js",
    "products:90d:refresh": "node kiotvietSync/product90dReport.js",
    "telegram-manager:set-webhook": "node telegram/setManagerLeaveWebhook.js",
    "kiotviet-sync:preflight": "node kiotvietSync/preflightCheck.js",
    "kiotviet-sync:backfill": "node kiotvietSync/backfill.js",
    "kiotviet-sync:reconcile": "node kiotvietSync/reconcileCounts.js",
    "migrate:user-branches": "node scripts/migrateUserBranches.js",
    "vat-requests:import-order-vat": "node scripts/importOrderVat.js",
    "marketing:history:capture": "node scripts/capture-marketing-history.js",
    "marketing:history:import": "node scripts/import-marketing-history.js",
    "marketing:pancake:sync": "node scripts/sync-pancake-marketing.js",
    "marketing:summary:refresh": "node scripts/refresh-marketing-summary.js",
    "marketing:identity:import": "node scripts/import-pancake-identities.js",
    "invoices:price-audit": "node scripts/refresh-invoice-price-audit.js",
    "vt:normalize-notes": "node scripts/normalize-stock-position-notes.js",
    "vt:merge-duplicates": "node scripts/merge-stock-position-duplicates.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.6",
    "exceljs": "^4.4.0",
    "express": "^4.19.2",
    "google-auth-library": "^9.15.1",
    "googleapis": "^140.0.1",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.2.0",
    "nodemailer": "^9.0.6",
    "pg": "^8.23.0",
    "redis": "^5.12.1",
    "sanitize-html": "^2.18.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "dotenv": "^16.4.5",
    "jsdom": "^30.0.1"
  }
}
