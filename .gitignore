# ==========================================
# Git Ignore — TKS Dashboard
# ==========================================

# Thông tin nhạy cảm — KHÔNG đẩy lên GitHub
# (chứa CLIENT_ID, CLIENT_SECRET của KiotViet)
# Thêm lại thủ công sau khi clone: clasp login && clasp pull
.clasp.json
.clasp.*.json

# Node modules (nếu dùng clasp local)
node_modules/

# server/.env chứa CLIENT_ID/CLIENT_SECRET của KiotViet — KHÔNG đẩy lên GitHub
server/.env

# Mọi file .env ở bất kỳ thư mục nào (kể cả .env ở thư mục gốc, vốn đang chứa
# JWT_SECRET / GOOGLE_SERVICE_ACCOUNT_JSON / SMTP_APP_PASSWORD dùng cho dev local).
# Pattern không có dấu "/" nên khớp ở mọi cấp thư mục.
.env
.env.*
!.env.example

# Local development preview (không cần commit)
dev/

# File tạm của hệ điều hành
.DS_Store
Thumbs.db
desktop.ini

# File tạm của editor
*.swp
*.swo
.vscode/settings.json

# Claude Code local config (khong lien quan code project)
.claude/

# Log files
*.log

# Temporary generated files
.tmp*/
.tmp-phase-a/
.superpowers/
.worktrees/

# Trang thai hoi thoai tam thoi cua bot Telegram nghi phep (du lieu song runtime,
# khong phai du lieu goc — xem server/telegram/conversationStore.js)
server/data/telegram_conversations.json*

# Du lieu runtime cua chuong thong bao + yeu cau doi vai tro (tich luy khi chay
# server/test, khong phai du lieu goc — xem server/notifications/notificationRepository.js
# va server/auth/roleChangeRequestRepository.js)
server/data/notifications.json*
server/data/roleChangeRequests.json*

# Du lieu nguoi dung thuc (du lieu song tren server, KHONG duoc ghi de boi GitHub)
# File nay duoc tao tu dong khi server khoi dong lan dau (xem server/auth/localUserStore.js)
# De seed du lieu ban dau: copy server/data/users.json.example -> server/data/users.json
server/data/users.json
